NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/repairtrack?schema=public"

JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

SEED_USER_PASSWORD=replace_with_a_development_password
