NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/repairtrack?schema=public"

JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5174
PUBLIC_API_URL=http://localhost:5001/api/v1

# Optional integrations. When absent, delivery is recorded as SKIPPED locally.
RESEND_API_KEY=
EMAIL_FROM="RepairTrack <onboarding@resend.dev>"
NOTIFY_USER_ID=
NOTIFY_API_KEY=
NOTIFY_SENDER_ID=NotifyDEMO
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
ERROR_WEBHOOK_URL=

SEED_USER_PASSWORD=replace_with_a_development_password
